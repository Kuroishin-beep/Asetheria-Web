# ---------------------------------------------------------------------------
# Neon Postgres. On Vercel, adding the Neon integration injects this for you.
# Locally, copy the pooled connection string from the Neon dashboard.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/asetheria?sslmode=require"

# ---------------------------------------------------------------------------
# Session signing secret. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Initial accounts, created by `npm run db:seed`.
# Change these before deploying. The DM account can edit everything;
# the player account is read-only and never sees entries marked secret.
# ---------------------------------------------------------------------------
DM_USERNAME="dm"
DM_PASSWORD="change-this-dm-password"

PLAYER_USERNAME="party"
PLAYER_PASSWORD="change-this-player-password"
